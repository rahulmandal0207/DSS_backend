# Copy to .env and adjust. Every setting is optional unless noted.
# Full reference: docs/operations.md

# Video: a camera index, or a path or URL to a video.
DSS_VIDEO_SOURCE=0
# DSS_VIDEO_LOOP=true

# Network. Binding beyond localhost requires DSS_API_KEY.
DSS_HOST=127.0.0.1
DSS_PORT=8000
# DSS_API_KEY=
# DSS_CORS_ORIGINS=https://console.example.com

# Privacy: set to false to run on measurements alone, with no video leaving the process.
DSS_STREAM_ENABLED=true

# Alerts
DSS_SOUND_ENABLED=false

# Optional classifier, from `dss train`. Only load models you trained yourself.
# DSS_MODEL_PATH=models/drowsiness.joblib

# Logging
DSS_LOG_LEVEL=INFO
DSS_LOG_FORMAT=text
